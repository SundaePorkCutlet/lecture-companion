{
  "name": "lecture-companion",
  "version": "0.10.1",
  "private": true,
  "type": "module",
  "description": "Local lecture evidence capture and bounded batches for an AI study partner",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "lecture-companion": "bin/lecture"
  },
  "scripts": {
    "build:skill": "node scripts/package-skill.mjs",
    "check:skill": "node scripts/package-skill.mjs --check",
    "package:skill": "node scripts/package-skill.mjs --archive",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/browser-integration.mjs",
    "test:aside": "node test/aside-browser-integration.mjs",
    "test:onboarding:browser": "node test/onboarding-browser-integration.mjs",
    "test:release:browser": "node test/release-browser-integration.mjs",
    "demo": "node bin/lecture.mjs demo"
  }
}
